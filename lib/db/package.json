{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "tsx ./scripts/migrate.ts",
    "reconcile": "tsx ./scripts/migrate.ts --reconcile && tsx ./scripts/check-drift.ts",
    "push": "drizzle-kit generate --config ./drizzle.config.ts && tsx ./scripts/migrate.ts && tsx ./scripts/check-drift.ts",
    "push-force": "drizzle-kit generate --config ./drizzle.config.ts && tsx ./scripts/migrate.ts && tsx ./scripts/check-drift.ts",
    "check-drift": "tsx ./scripts/check-drift.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
